# OpenAI API key for chat. Keep this secret on the VPS only.
AI_API_KEY=
AI_MODEL=gpt-6-luna
# Vercel proxies /api/* server-side, so browser CORS is not required.
ALLOWED_ORIGINS=
CACHE_DIR=/var/lib/field-shift
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT="FieldShift/0.1 (+https://github.com/Priyapta/nasa-hacktahon)"
DEMO_BBOX=110.5415518,-7.2832140,111.2468490,-6.9094001
# Neon pooled connection string, with sslmode=require (backend only).
DATABASE_URL=
COOKIE_SECURE=true

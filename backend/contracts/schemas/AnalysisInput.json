{
  "$defs": {
    "LocationInput": {
      "additionalProperties": false,
      "properties": {
        "lat": {
          "maximum": 90,
          "minimum": -90,
          "title": "Lat",
          "type": "number"
        },
        "lon": {
          "maximum": 180,
          "minimum": -180,
          "title": "Lon",
          "type": "number"
        }
      },
      "required": [
        "lat",
        "lon"
      ],
      "title": "LocationInput",
      "type": "object"
    },
    "RotationInput": {
      "additionalProperties": false,
      "properties": {
        "has_pattern": {
          "title": "Has Pattern",
          "type": "boolean"
        },
        "stages": {
          "items": {
            "$ref": "#/$defs/RotationStage"
          },
          "maxItems": 6,
          "title": "Stages",
          "type": "array"
        }
      },
      "required": [
        "has_pattern",
        "stages"
      ],
      "title": "RotationInput",
      "type": "object"
    },
    "RotationStage": {
      "additionalProperties": false,
      "properties": {
        "crop_id": {
          "enum": [
            "padi_sawah",
            "jagung",
            "kedelai",
            "kacang_hijau",
            "orok_orok",
            "bera"
          ],
          "title": "Crop Id",
          "type": "string"
        },
        "months": {
          "anyOf": [
            {
              "maximum": 6,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Months"
        }
      },
      "required": [
        "crop_id"
      ],
      "title": "RotationStage",
      "type": "object"
    },
    "TimeInput": {
      "additionalProperties": false,
      "properties": {
        "start_month": {
          "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
          "title": "Start Month",
          "type": "string"
        },
        "horizon_months": {
          "enum": [
            6,
            12,
            18,
            24
          ],
          "title": "Horizon Months",
          "type": "integer"
        }
      },
      "required": [
        "start_month",
        "horizon_months"
      ],
      "title": "TimeInput",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "location": {
      "$ref": "#/$defs/LocationInput"
    },
    "rotation": {
      "$ref": "#/$defs/RotationInput"
    },
    "time": {
      "$ref": "#/$defs/TimeInput"
    },
    "water_source": {
      "enum": [
        "tadah_hujan",
        "irigasi"
      ],
      "title": "Water Source",
      "type": "string"
    },
    "lang": {
      "default": "id",
      "enum": [
        "id",
        "en"
      ],
      "title": "Lang",
      "type": "string"
    }
  },
  "required": [
    "location",
    "rotation",
    "time",
    "water_source"
  ],
  "title": "AnalysisInput",
  "type": "object"
}

# Reference only: local Uvicorn does not automatically load this file.
# Set environment variables in the WSL shell; Compose reads the root .env instead.
ALLOWED_ORIGINS=http://localhost:3000
# Reserved for future database integration, not used by the health endpoint.
# FastAPI runs locally; use the database port published by Compose.
# DATABASE_URL=postgresql://field_shift:URL_ENCODED_PASSWORD@127.0.0.1:5432/field_shift

# Geocoding uses Nominatim-compatible search. Public provider: explicit user
# submissions only, <= 1 upstream request/second across this deployment.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT="FieldShift/0.1 (+https://github.com/Priyapta/nasa-hacktahon)"
# west,south,east,north: rectangle from OSM Grobogan relation 9687051.
DEMO_BBOX=110.5415518,-7.2832140,111.2468490,-6.9094001
# Optional absolute parent directory; geocode cache uses CACHE_DIR/geocode.
# CACHE_DIR=/var/data/field-shift

# npm run dev:backend / start:backend loads backend/.env automatically.
# Direct Uvicorn commands need exported variables; Compose reads the root .env.
ALLOWED_ORIGINS=http://localhost:3000
# Copy the pooled connection string from Neon Console > Connect.
DATABASE_URL=
# HTTPS production: true. Local HTTP development: false.
COOKIE_SECURE=false

# Geocoding uses Nominatim-compatible search. Public provider: explicit user
# submissions only, <= 1 upstream request/second across this deployment.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT="FieldShift/0.1 (+https://github.com/Priyapta/nasa-hacktahon)"
# Agronomic demo rectangle remains Grobogan; search has an independent Indonesia rectangle.
DEMO_BBOX=110.5415518,-7.2832140,111.2468490,-6.9094001
# west,south,east,north; names are restricted to countrycodes=id as well.
GEOCODE_BBOX=94,-12,142,7
# Optional absolute parent directory; geocode cache uses CACHE_DIR/geocode.
# CACHE_DIR=/var/data/field-shift

# OpenAI chat. Set an OpenAI API key on the backend only.
AI_API_KEY=
AI_MODEL=gpt-6-luna
